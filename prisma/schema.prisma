generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DATABASE_URL_UNPOOLED")
}

model CellGroup {
  id          String   @id @default(cuid())
  name        String
  // Compatibility-only until the separately approved data-retirement migration.
  leaderId    String
  meetingDay  String?
  meetingTime String?
  barangay    String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())

  @@index([isActive])
}

model Sermon {
  id                String   @id @default(cuid())
  title             String
  speaker           String
  series            String?
  videoUrl          String?
  audioUrl          String?
  notes             String?
  scriptureFocus    String?
  weeklyGuide       String?
  reflectionPrompts String?
  thumbnail         String?
  date              DateTime
  tags              String
  isPublished       Boolean  @default(true)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([date])
  @@index([series])
  @@index([speaker])
  @@index([isPublished])
}

model Event {
  id                   String              @id @default(cuid())
  title                String
  description          String
  location             String
  startDate            DateTime
  endDate              DateTime?
  imageUrl             String?
  isPublished          Boolean             @default(true)
  requiresRegistration Boolean             @default(false)
  capacity             Int?
  registrationDeadline DateTime?
  registrations        EventRegistration[]
  createdAt            DateTime            @default(now())
  updatedAt            DateTime            @updatedAt

  @@index([startDate])
  @@index([isPublished])
}

model EventRegistration {
  id        String   @id @default(cuid())
  eventId   String
  event     Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  name      String
  email     String
  phone     String?
  notes     String?
  status    String   @default("CONFIRMED")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([eventId, email])
  @@index([eventId, status])
  @@index([createdAt])
}

model Ministry {
  id          String   @id @default(cuid())
  name        String
  description String
  imageUrl    String?
  leader      String
  sortOrder   Int      @default(0)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())

  @@index([isActive])
}

model BlogPost {
  id          String    @id @default(cuid())
  title       String
  slug        String    @unique
  content     String
  excerpt     String?
  category    String
  imageUrl    String?
  authorId    String
  isPublished Boolean   @default(false)
  publishedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([slug])
  @@index([isPublished, publishedAt])
}

model PrayerRequest {
  id          String   @id @default(cuid())
  name        String
  email       String?
  request     String
  isPrivate   Boolean  @default(false)
  submittedAt DateTime @default(now())

  @@index([submittedAt])
}

model VisitPlan {
  id                  String   @id @default(cuid())
  name                String
  email               String
  phone               String?
  city                String?
  preferredService    String
  visitDate           DateTime?
  adultCount          Int      @default(1)
  isFirstTimeGuest    Boolean  @default(true)
  bringingKids        Boolean  @default(false)
  kidsCount           Int?
  kidsDetails         String?
  wantsUsherFollowUp  Boolean  @default(false)
  wantsPastorFollowUp Boolean  @default(false)
  notes               String?
  submittedAt         DateTime @default(now())
  updatedAt           DateTime @updatedAt

  @@index([submittedAt])
  @@index([preferredService, submittedAt])
  @@index([visitDate])
}

model GivingRecord {
  id              String   @id @default(cuid())
  stripePaymentId String   @unique
  amount          Int
  currency        String   @default("PHP")
  category        String
  giverName       String?
  giverEmail      String?
  status          String
  createdAt       DateTime @default(now())

  @@index([createdAt])
  @@index([status])
}

model Setting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}
